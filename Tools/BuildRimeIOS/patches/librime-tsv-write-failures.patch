diff --git a/src/rime/dict/tsv.cc b/src/rime/dict/tsv.cc
--- a/src/rime/dict/tsv.cc
+++ b/src/rime/dict/tsv.cc
@@ -59,29 +59,46 @@
 int TsvWriter::operator()(Source* source) {
   if (!source)
-    return 0;
+    return -1;
   LOG(INFO) << "writing tsv file: " << file_path_;
   std::ofstream fout(file_path_.c_str());
+  if (!fout.is_open() || !fout)
+    return -1;
   if (!file_description.empty()) {
     fout << "# " << file_description << std::endl;
   }
+  if (!fout)
+    return -1;
   string key, value;
   while (source->MetaGet(&key, &value)) {
     fout << "#@" << key << '\t' << value << std::endl;
+    if (!fout)
+      return -1;
   }
+  if (source->HasError())
+    return -1;
   Tsv row;
   int num_entries = 0;
   while (source->Get(&key, &value)) {
     row.clear();
-    if (formatter_(key, value, &row) && !row.empty()) {
-      for (auto it = row.cbegin(); it != row.cend(); ++it) {
-        if (it != row.cbegin())
-          fout << '\t';
-        fout << *it;
-      }
-      fout << std::endl;
-      ++num_entries;
+    if (!formatter_(key, value, &row) || row.empty()) {
+      if (strict_formatter_)
+        return -1;
+      continue;
+    }
+    for (auto it = row.cbegin(); it != row.cend(); ++it) {
+      if (it != row.cbegin())
+        fout << '\t';
+      fout << *it;
     }
+    fout << std::endl;
+    if (!fout)
+      return -1;
+    ++num_entries;
   }
+  if (source->HasError())
+    return -1;
+  fout.flush();
+  const bool complete = static_cast<bool>(fout);
   fout.close();
-  return num_entries;
+  return complete && fout ? num_entries : -1;
 }
