# ---------------------------------------------------------------------------
# Pinned upstream versions for the macOS engine build.
# Every artifact here is pinned by URL + sha256 / git commit.
# Do NOT bump these without re-running the full build and tests.
# ---------------------------------------------------------------------------

# --- local toolchain ---------------------------------------------------------
# CMake is fetched as an official prebuilt binary (not installed system-wide).
CMAKE_VERSION=3.31.12
CMAKE_BASENAME=cmake-${CMAKE_VERSION}-macos-universal
CMAKE_TARBALL=${CMAKE_BASENAME}.tar.gz
CMAKE_URL=https://cmake.org/files/v3.31/${CMAKE_TARBALL}
CMAKE_SHA256=799af7fd545db9bf1b9cfe72f8095880e727a2d4e0df0e3dffc3bc7b95c2d3b0

# --- librime (engine) --------------------------------------------------------
# Release 1.17.0 (2026-06-06). The annotated tag object is a52a3400f8b7679e839bc5fb8e6309a0fc4424da;
# the tagged commit (what we build) is the SHA below. Homebrew homebrew-core uses the same commit.
LIBRIME_REPO=https://github.com/rime/librime.git
LIBRIME_COMMIT=33e78140250125871856cdc5b42ddc6a5fcd3cd4

# librime 1.17.0 records these exact commits for its third-party deps
# (gitlinks of the `deps/` submodules at LIBRIME_COMMIT). We build them from
# source, statically, into the local prefix — no system-wide installs.
GLOG_COMMIT=7b134a5c82c0c0b5698bb6bf7a835b230c5638e4
LEVELDB_COMMIT=99b3c03b3284f5886f9ef9a4ef703d57373e61be
# marisa-trie 0.3.1 is the ONE marisa actually linked: librime consumes it, and
# OpenCC is built with USE_SYSTEM_MARISA=ON against this same prefix install
# (its bundled deps/marisa-0.2.6 is neither built nor installed) — see
# 02-build-deps.sh and scripts/07-verify-marisa.sh.
MARISA_COMMIT=3e87d53b78e15f2f43783d5e376561a8c9722051
OPENCC_COMMIT=556ed22496d650bd0b13b6c163be9814637970ae
YAMLCPP_COMMIT=2f86d13775d119edbb69af52e5f566fd65c6953b

# --- boost -------------------------------------------------------------------
# Same version & tarball the official librime build scripts use (install-boost.sh).
BOOST_VERSION=1.89.0
BOOST_DIRNAME=boost-${BOOST_VERSION}
BOOST_TARBALL=boost_1_89_0.tar.gz
BOOST_URL=https://archives.boost.io/release/${BOOST_VERSION}/source/${BOOST_TARBALL}
BOOST_SHA256=9de758db755e8330a01d995b0a24d09798048400ac25c03fc5ea9be364b13c93

# ---------------------------------------------------------------------------
# macOS deployment target for local builds (native CLI only; iOS slices are a
# later, separate concern).
#
# Mechanism: common.sh exports this variable so it reaches every child —
# CMake (each dependency build + librime) and boost b2 — and the build scripts
# additionally pass it explicitly (-DCMAKE_OSX_DEPLOYMENT_TARGET and
# -mmacosx-version-min). scripts/06-verify-macos.sh then checks the Mach-O
# minimum OS of rime_cli and of object members inside every static library.
#
# Override with env if needed, e.g.  MACOSX_DEPLOYMENT_TARGET=14.0 ...
MACOSX_DEPLOYMENT_TARGET=${MACOSX_DEPLOYMENT_TARGET:-13.0}
